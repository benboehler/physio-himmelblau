---
import Hero from '../sections/Hero.astro';
import Offer from '../sections/Offer.astro';
import About from '../sections/About.astro';
import Contact from '../sections/Contact.astro';
import PinnedPanelsAnimation from '../ui/PinnedPanelsAnimation.astro';
---

<PinnedPanelsAnimation />

<div id="container" class="w-full slides-wrapper">
    <main>
        <div id="start">
            <section class="section">
                <div class="section-content">
                    <div class="section-inner">
                        <Hero />
                    </div>
                </div>
            </section>
        </div>
        <div id="angebot" class="scroll-mt-12">
            <section class="section">
                <div class="section-content">
                    <div class="section-inner">
                        <Offer />
                    </div>
                </div>
            </section>
        </div>
        <div id="ueber-mich" class="scroll-mt-12">
            <section class="section">
                <div class="section-content">
                    <div class="section-inner">
                        <About />
                    </div>
                </div>
            </section>
        </div>
        <div id="kontakt" class="scroll-mt-12">
            <section class="section">
                <div class="section-content">
                    <div class="section-inner">
                        <Contact />
                    </div>
                </div>
            </section>
        </div>
    </main>
</div>
