<style is:global>
    .slides-wrapper { position: relative; }
    .slides-wrapper .section {
        width: 100%;
        min-height: 100svh;
        position: relative;
        box-sizing: border-box;
    }
    .section-content { width: 100%; }
    .section-inner {
        width: 100%;
        max-width: 1152px;
        margin-inline: auto;
        padding-inline: 1rem;
        display: flex;
        flex-direction: column;
        align-items: center;
    }
</style>

<script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(ScrollTrigger);
    let cleanup = () => {};

    function initPinnedPanels() {
        cleanup();
        const panels = gsap.utils.toArray<HTMLElement>('.slides-wrapper .section');
        const media = gsap.matchMedia();
        media.add('(prefers-reduced-motion: no-preference)', () => {
            panels.slice(0, -1).forEach((panel) => {
                const content = panel.querySelector<HTMLElement>('.section-content');
                if (!content) return;
                // Tall panels scroll naturally before their bottom edge is pinned.
                gsap.fromTo(content, { scale: 1, opacity: 1 }, {
                    scale: 0.9, opacity: 0, ease: 'none',
                    scrollTrigger: {
                        trigger: panel,
                        start: 'bottom bottom',
                        end: () => '+=' + window.innerHeight,
                        pin: panel,
                        pinSpacing: false,
                        // Match the background's scroll catch-up time.
                        scrub: 0.6,
                        invalidateOnRefresh: true,
                    },
                });
            });
        });
        cleanup = () => media.revert();
        ScrollTrigger.refresh();
    }

    initPinnedPanels();
    document.addEventListener('astro:page-load', initPinnedPanels);
    document.addEventListener('astro:before-swap', () => cleanup());
    window.addEventListener('load', () => ScrollTrigger.refresh(), { once: true });
</script>
